# ==============================================================================
# Omni-Personal-Agent Environment Configuration (.env.example)
# Copy this file to `.env` and fill in OPENAI_API_KEY to switch from the built-in
# deterministic MockLLMProvider to any live OpenAI-compatible endpoint.
# ==============================================================================

# 1. Unified OpenAI-Compatible Endpoint Credentials
# Leave OPENAI_API_KEY empty (or "mock") to run full offline deterministic mode.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional separate local Ollama / vLLM endpoint for privacy-routed SLM calls.
# Defaults to OPENAI_BASE_URL when left empty.
LOCAL_SLM_BASE_URL=
LOCAL_SLM_API_KEY=ollama

# 2. Pinned Model Snapshot Identifiers (Compatible with OpenAI / DashScope / DeepSeek / Ollama)
LLM_MODEL=gpt-4o-2024-11-20
SLM_MODEL=gpt-4o-mini-2024-07-18
LOCAL_PRIVACY_MODEL=qwen2.5-7b-instruct
VLM_MODEL=gpt-4o-2024-11-20
EMBEDDING_MODEL=text-embedding-3-small

# 3. Controlled Inference & Reproducibility Parameters
TEMPERATURE=0.0
RANDOM_SEED=42
REQUEST_TIMEOUT_SECONDS=45.0

# 4. Hybrid Memory & Router Hyperparameters
MEMORY_DB_PATH=runtime_data/memory/omni_memory.sqlite3
EMBEDDING_DIM=256
MEMORY_BASE_HALF_LIFE_HOURS=168.0
MEMORY_ABSTENTION_THRESHOLD=0.18
ROUTER_COMPLEXITY_THRESHOLD=0.42
ROUTER_TOOL_BUDGET=6
AGENT_MAX_REFLECT_RETRIES=2

# 5. Structured Observability & Workspace Sandbox
TRACE_LOG_PATH=logs/trace_events.jsonl
SANDBOX_WORKSPACE_DIR=runtime_data/workspace
